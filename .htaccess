RewriteEngine On

# Don't process POST/PUT/DELETE requests that are not files/directories
# Internally rewrite to public folder instead of redirecting (preserves POST data)
RewriteCond %{REQUEST_URI} !^/public/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ public/index.php?url=$1 [QSA,L]
